# Example profiles.yml for local dbt runs
# Copy this to /dbt/profiles.yml and set the values or export env vars used below

dataengineering_dbt:
  target: dev
  outputs:
    dev:
      type: clickhouse
      schema: default
      host: "{{ env_var('CLICKHOUSE_HOST', 'clickhouse') }}"
      port: 8123
      user: default
      password: "ch_pass"
      secure: false
